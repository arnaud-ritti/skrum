{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "arnaud-ritti/skrum",
    "version": "0.0.4",
    "type": "project",
    "description": "Open-source, self-hosted retrospectives, planning poker, whiteboards, surveys and games for agile teams.",
    "keywords": [
        "retrospective",
        "planning-poker",
        "agile",
        "scrum",
        "whiteboard",
        "self-hosted",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.399",
        "dicebear/core": "^10.7",
        "dicebear/styles": "^10.6",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^1.1",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.0",
        "laravel/octane": "^2.20",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "socialiteproviders/openidconnect": "^1.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "rector": [
            "rector process"
        ],
        "rector:check": [
            "rector process --dry-run"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test --parallel"
        ],
        "test:arch": [
            "@php artisan config:clear --ansi",
            "pest --testsuite=Arch"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "npm run build",
            "@putenv DB_CONNECTION=pgsql",
            "@putenv DB_DATABASE=testing",
            "pest tests/Browser"
        ],
        "test:browser:shards": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-browser"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
