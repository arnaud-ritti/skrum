APP_NAME=Skrum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Passkeys identify their user through a secret that defaults to APP_KEY. Set it (to the current
# APP_KEY on an existing instance) before you rotate APP_KEY, or every registered passkey stops working.
# PASSKEYS_USER_HANDLE_SECRET=
# Instance time zone. Decides the day an action item becomes overdue.
# Set before first use; affects how stored timestamps are read.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. PostgreSQL is the default and the reference; MariaDB, MySQL and SQLite are supported too.
# docs/database.md says which to choose and what each needs. `php artisan skrum:check-database` verifies it.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=skrum
DB_USERNAME=sail
DB_PASSWORD=password

# MariaDB 10.11 or later (Sail: `sail --profile mariadb up -d`)
# DB_CONNECTION=mariadb
# DB_HOST=mariadb
# DB_PORT=3306

# MySQL 8.4 or later (Sail: `sail --profile mysql up -d`)
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306

# SQLite, for a small instance: one file, one writer at a time. Needs PHP 8.4.
# Also set SESSION_DRIVER=file and CACHE_STORE=file below, to keep sessions and cache out of that file.
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/skrum.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is sent over HTTPS only when APP_URL starts with https://.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SKRUM_UPDATE_CHECK_ENABLED=true
SKRUM_SIGNUP_MODE=invite
SKRUM_REQUIRE_EMAIL_VERIFICATION=true
SKRUM_ALLOWED_EMAIL_DOMAINS=
# DiceBear style (CC0 styles need no attribution; thumbs is CC0)
SKRUM_AVATAR_STYLE=thumbs

# Daily due-date and overdue reminders for action items, sent at this time
# in APP_TIMEZONE (e-mail digest and notification bell). false turns them off.
SKRUM_ACTION_ITEM_REMINDERS=true
SKRUM_ACTION_ITEM_REMINDER_TIME=08:00

# SKRUM_PASSWORD_BREACH_CHECK=false   # an instance without outbound access

# GIFs in cards: giphy or tenor, with your own API key. Leave empty to hide GIFs.
# Searches and images go through Skrum, so browsers never contact the provider.
SKRUM_GIF_PROVIDER=
SKRUM_GIF_API_KEY=
# g, pg, pg-13 or r
SKRUM_GIF_RATING=g

# AI text generation via Laravel AI SDK, also editable in Administration > AI.
# Saved admin fields override the corresponding environment variables.
# Providers: anthropic, openai, openai-compatible, gemini, azure, bedrock, groq, xai, deepseek, mistral, ollama, openrouter.
# Empty provider/model disables AI. Most providers also require an API key;
# ollama and openai-compatible allow keyless servers. openai-compatible and
# azure require a base URL. Ollama uses http://host:11434 (without /v1).
# Legacy openai + custom base URL still uses Chat Completions.
# Native Bedrock uses the AWS SDK and ignores the base URL. Use a Bedrock API key
# or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (optional AWS_SESSION_TOKEN).
# Set SKRUM_LLM_BEDROCK_USE_DEFAULT_CREDENTIALS=true to use an IAM role or the
# default AWS credential chain. This infrastructure setting is environment-only.
# Board content is sent to the configured provider for requested AI features.
SKRUM_LLM_PROVIDER=
SKRUM_LLM_API_KEY=
SKRUM_LLM_MODEL=
SKRUM_LLM_BASE_URL=
SKRUM_LLM_BEDROCK_REGION=us-east-1
SKRUM_LLM_BEDROCK_USE_DEFAULT_CREDENTIALS=false
# AWS_SESSION_TOKEN=

# MCP server at {APP_URL}/mcp for AI assistants that send an API token
# (created under Settings → API tokens). Requests and write/delete calls
# are limited per token and per minute.
SKRUM_MCP_ENABLED=true
SKRUM_MCP_RATE_LIMIT=120
SKRUM_MCP_WRITE_RATE_LIMIT=30

# Integrations (optional). A provider appears on each team's integrations page
# (workspace Owners/Admins only) when all its values are set. Every call goes
# from Skrum's server; tokens are stored encrypted with APP_KEY (keep
# APP_PREVIOUS_KEYS when you rotate it, otherwise teams must reconnect).
# Slack: create an app with the "incoming-webhook" scope and the redirect URL
# ${APP_URL}/integrations/slack/callback (Slack requires an HTTPS URL).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Telegram: create a bot with @BotFather. Use it for this Skrum instance only and
# never set a webhook on it: the scheduler polls it every minute.
TELEGRAM_BOT_TOKEN=
# Jira Cloud: an OAuth 2.0 (3LO) app on developer.atlassian.com with the callback
# ${APP_URL}/integrations/jira/callback and the scopes read:jira-work,
# write:jira-work, read:jira-user, read:board-scope:jira-software and
# read:sprint:jira-software, plus manage:jira-webhook for live status sync
# (connections made without it keep polling until reconnected).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Linear: an OAuth application (Linear settings → API) with the callback
# ${APP_URL}/integrations/linear/callback.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Linear status sync webhooks (optional): the signing secret of a Linear webhook
# pointing to ${APP_URL}/integrations/webhooks/linear.
LINEAR_WEBHOOK_SECRET=
# Jira Server / Data Center (8.14+): the server's base URL (optionally with its
# context path). OAuth 2.0 (8.22+, preferred): an incoming application link with
# the redirect URL ${APP_URL}/integrations/jira-dc/callback. Without OAuth values,
# Owners/Admins paste a personal access token (set JIRA_DC_PERSONAL_TOKENS=false
# to forbid tokens; every connection made with a token then turns to "Reconnect
# required" on its next call).
JIRA_DC_BASE_URL=
JIRA_DC_CLIENT_ID=
JIRA_DC_CLIENT_SECRET=
JIRA_DC_PERSONAL_TOKENS=true
# GitHub Issues: a GitHub App with the callback and setup URL
# ${APP_URL}/integrations/github/callback, repository permissions Issues (read and
# write) and Metadata (read), organization permission Members (read), the events
# issues, installation and installation_repositories, and the webhook URL
# ${APP_URL}/integrations/webhooks/github with its secret. The private key is the
# PEM with "\n" for newlines, or a file path.
# Residual risk: GitHub cannot guard a write against a concurrent edit, so an issue
# changed in GitHub at the very moment skrum writes it can be overwritten.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Microsoft Teams: teams paste the URL of a Workflows webhook ("Post to a channel
# when a webhook request is received"). Hosts other than *.logic.azure.com and
# *.api.powerplatform.com must be listed (comma-separated).
MSTEAMS_ENABLED=false
MSTEAMS_ALLOWED_HOSTS=
# Mattermost: the one server teams may post to; they paste an incoming webhook
# of it (${MATTERMOST_URL}/hooks/…).
MATTERMOST_URL=
# Generic outgoing webhooks (signed JSON POSTs). Private networks and plain HTTP
# are refused unless allowed here.
OUTGOING_WEBHOOKS_ENABLED=false
OUTGOING_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
OUTGOING_WEBHOOKS_ALLOW_HTTP=false
# Status sync: Jira and Jira Data Center webhooks are registered by skrum, or by
# hand from the integration card, at
# ${APP_URL}/integrations/webhooks/{jira|jira-dc}/{integration}/{token}; Linear and
# GitHub use ${APP_URL}/integrations/webhooks/{linear|github}. Providers push
# changes when APP_URL is publicly reachable (auto), always (on) or never (off); otherwise
# skrum polls every INTEGRATIONS_POLL_MINUTES minutes (1–60).
INTEGRATIONS_INBOUND_WEBHOOKS=auto
INTEGRATIONS_POLL_MINUTES=5
# Emailing retrospective results needs a mailer that delivers (not log or array).

# Single sign-on — a provider is enabled when all its values are set.
# Callback URLs: ${APP_URL}/auth/{google|github|entra|oidc}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Entra: enable the optional "xms_edov" ID-token claim in the app registration,
# otherwise Entra sign-ins cannot link to existing accounts by email.
# Single-organisation deployments: set ENTRA_TENANT to your tenant id (or
# "organizations"). The default "common" also admits personal Microsoft accounts.
ENTRA_TENANT=common
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=

# Optional: left empty, the three values are derived from APP_KEY. Set them to pin your own.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-side connection from Laravel to Reverb (publishing events).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Where browsers connect. Leave empty in production: the browser then uses the
# page's own host and port, which the image's Caddy proxies to Reverb.
# Local Sail development runs Reverb on :8080, so set it explicitly here.
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http
# Hosts whose pages may open a websocket, comma separated (`*` wildcards allowed).
# Defaults to the host of APP_URL.
# REVERB_ALLOWED_ORIGINS=skrum.example.com

# Live cursors send about 25 messages per second per participant. If you turn on
# REVERB_APP_RATE_LIMITING_ENABLED, keep
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS >= 25 x REVERB_APP_RATE_LIMIT_DECAY_SECONDS
# (e.g. 1500 attempts per 60 seconds).

# Reverb refuses event bodies above REVERB_MAX_REQUEST_SIZE bytes (default 10000),
# like hosted Pusher's 10 KB limit. The drawing game splits live strokes at 400
# points so each committed stroke broadcast stays around 5 KB; keep the default
# or raise it, never lower it below that.
# REVERB_MAX_REQUEST_SIZE=10000

# --- Production (Docker image, see README) ---
# A production install starts from .env.production.example, not from this file.
# The container refuses to start with APP_DEBUG=true unless SKRUM_ALLOW_DEBUG=true.
# SERVER_NAME: a public domain (e.g. skrum.example.com) turns on automatic HTTPS;
# ":80" serves plain HTTP, e.g. behind a TLS-terminating reverse proxy.
SERVER_NAME=:80
# Proxies whose forwarded headers are trusted: "*" (the default when this line is
# absent), a comma-separated list of proxy IPs, or "none".
TRUSTED_PROXIES=none
# Run database migrations when the container starts.
SKRUM_RUN_MIGRATIONS=true
# Octane worker count (auto = FrankenPHP default, 2 per CPU) and requests per worker before recycling.
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
# Inertia server-side rendering is not shipped in the image; keep false.
INERTIA_SSR_ENABLED=false
# Sail/internal only: the port Reverb listens on. The production compose file fixes it at 8080.
REVERB_SERVER_PORT=8080
