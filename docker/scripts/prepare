#!/command/with-contenv sh
set -e

cd /app

missing=""

required="APP_KEY DB_CONNECTION"

if [ "${DB_CONNECTION:-}" = "sqlite" ]; then
    required="$required DB_DATABASE"
else
    required="$required DB_PASSWORD"
fi

for variable in $required; do
    eval "value=\${$variable:-}"

    if [ -z "$value" ]; then
        missing="$missing $variable"
    fi
done

if [ -n "$missing" ]; then
    echo "skrum: missing required environment variables:$missing (see .env.production.example)" >&2
    exit 1
fi

app_debug=$(printf '%s' "${APP_DEBUG:-}" | tr '[:upper:]' '[:lower:]' | tr -d '()')

case "$app_debug" in
    true | 1 | on | yes)
        if [ "${SKRUM_ALLOW_DEBUG:-}" != "true" ]; then
            echo "skrum: APP_DEBUG is enabled; debug pages expose configuration. Set APP_DEBUG=false (or SKRUM_ALLOW_DEBUG=true to override)." >&2
            exit 1
        fi
        ;;
esac

if [ "${APP_ENV:-}" != "production" ]; then
    echo "skrum: warning: APP_ENV is '${APP_ENV:-}', not 'production'" >&2
fi

if [ "${LOG_CHANNEL:-}" != "stderr" ]; then
    echo "skrum: warning: LOG_CHANNEL is '${LOG_CHANNEL:-}', not 'stderr'; logs will not reach docker logs" >&2
fi

server_port="${SERVER_NAME:-}"
server_port="${server_port#http://}"

case "$server_port" in
    :[0-9]*)
        if [ "${server_port#:}" -lt 1024 ] 2>/dev/null; then
            echo "skrum: warning: SERVER_NAME is '${SERVER_NAME}', a privileged port; the image serves :8000 by default and the Compose files publish 8000 and 8443. Remove SERVER_NAME (or set SERVER_NAME=:8000) and fetch the current Compose file." >&2
        fi
        ;;
esac

s6-setuidgid www-data php artisan optimize

if [ "$DB_CONNECTION" = "sqlite" ] && [ "$DB_DATABASE" != ":memory:" ]; then
    if [ "$(dirname "$DB_DATABASE")" = "/app/database" ]; then
        echo "skrum: warning: DB_DATABASE is '$DB_DATABASE', inside the image; unless a volume is mounted on it, the data is lost when the container is recreated" >&2
    fi

    mkdir -p "$(dirname "$DB_DATABASE")"
    chown www-data:www-data "$(dirname "$DB_DATABASE")"

    if [ ! -f "$DB_DATABASE" ]; then
        s6-setuidgid www-data touch "$DB_DATABASE"
    fi

    for file in "$DB_DATABASE" "$DB_DATABASE-wal" "$DB_DATABASE-shm"; do
        if [ -f "$file" ]; then
            chown www-data:www-data "$file"
        fi
    done
fi

s6-setuidgid www-data php artisan skrum:check-database

if [ "${SKRUM_RUN_MIGRATIONS:-true}" = "true" ]; then
    s6-setuidgid www-data php artisan migrate --force
else
    echo "skrum: SKRUM_RUN_MIGRATIONS is not true, skipping migrations"
fi
