# Skrum, production settings for the Docker image. See README.md, "Run with Docker".
# Save this file as .env beside the Compose file and fill the three values below.

# Public address of the instance, as typed in the browser.
APP_URL=https://skrum.example.com
# Print one with:
# docker run --rm --entrypoint php ghcr.io/arnaud-ritti/skrum:latest artisan key:generate --show
APP_KEY=
# Password of the database (not read with compose.production.sqlite.yaml).
DB_PASSWORD=

# --- Optional. Each line shows its default; SKRUM_IMAGE and the mail block show an example. ---

# Address the built-in Caddy serves. ":80" is plain HTTP, for a TLS-terminating
# reverse proxy in front.
# A domain (skrum.example.com) makes Caddy obtain its own certificate instead:
# ports 80 and 443 of the host must then be reachable from the internet.
# SERVER_NAME=:80
# Proxies whose forwarded headers are trusted: "*" (any), a comma-separated list
# of proxy IPs, or "none". Set it to none when the instance is reached directly,
# without a proxy in front: otherwise a visitor can forge their address.
# An empty value counts as absent in the image: it trusts every proxy.
# TRUSTED_PROXIES=*
# Host ports the container is published on. Automatic HTTPS needs 80 and 443.
# SKRUM_HTTP_PORT=80
# SKRUM_HTTPS_PORT=443

# Pin a version instead of following "latest".
# SKRUM_IMAGE=ghcr.io/arnaud-ritti/skrum:1.0

# Name shown in the interface and the mails (also editable in Administration).
# APP_NAME=Skrum
# Decides the day an action item becomes overdue. Set before first use.
# APP_TIMEZONE=UTC
# en, fr, es or de.
# APP_LOCALE=en
# Who may create an account: invite, open or domain (domain reads SKRUM_ALLOWED_EMAIL_DOMAINS).
# SKRUM_SIGNUP_MODE=invite
# Require email verification before using the instance; Administration > General can override it.
# SKRUM_REQUIRE_EMAIL_VERIFICATION=true

# Outgoing mail goes to the log until this block is filled in and uncommented
# (also editable in Administration).
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Email domains allowed to sign up when SKRUM_SIGNUP_MODE=domain, comma-separated.
# SKRUM_ALLOWED_EMAIL_DOMAINS=
# DiceBear avatar style (thumbs is CC0 and needs no attribution).
# SKRUM_AVATAR_STYLE=thumbs
# Daily reminders for action items, sent at this time in APP_TIMEZONE.
# SKRUM_ACTION_ITEM_REMINDERS=true
# SKRUM_ACTION_ITEM_REMINDER_TIME=08:00
# New passwords are checked against known data breaches (api.pwnedpasswords.com,
# by k-anonymity). Set to false on an instance without outbound access.
# SKRUM_PASSWORD_BREACH_CHECK=true
# SKRUM_PASSWORD_BREACH_CHECK_TIMEOUT=5
# GIFs in cards: giphy or tenor, with your own API key. Empty hides GIFs.
# SKRUM_GIF_PROVIDER=
# SKRUM_GIF_API_KEY=
# SKRUM_GIF_RATING=g
# AI text generation via Laravel AI SDK, also editable in Administration > AI.
# Saved admin fields override the corresponding environment variables.
# Providers: anthropic, openai, openai-compatible, gemini, azure, bedrock, groq, xai, deepseek, mistral, ollama, openrouter.
# Empty provider/model disables AI. Most providers also require an API key;
# ollama and openai-compatible allow keyless servers. openai-compatible and
# azure require a base URL. Ollama uses http://host:11434 (without /v1).
# Legacy openai + custom base URL still uses Chat Completions.
# Native Bedrock uses the AWS SDK and ignores the base URL. Use a Bedrock API key
# or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (optional AWS_SESSION_TOKEN).
# Set SKRUM_LLM_BEDROCK_USE_DEFAULT_CREDENTIALS=true to use an IAM role or the
# default AWS credential chain. This infrastructure setting is environment-only.
# Board content is sent to the configured provider for requested AI features.
# SKRUM_LLM_PROVIDER=
# SKRUM_LLM_API_KEY=
# SKRUM_LLM_MODEL=
# SKRUM_LLM_BASE_URL=
# SKRUM_LLM_BEDROCK_REGION=us-east-1
# SKRUM_LLM_BEDROCK_USE_DEFAULT_CREDENTIALS=false
# AWS_SESSION_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MCP server at /mcp for AI assistants, and its limits per token and per minute.
# SKRUM_MCP_ENABLED=true
# SKRUM_MCP_RATE_LIMIT=120
# SKRUM_MCP_WRITE_RATE_LIMIT=30
# Run database migrations when the container starts.
# SKRUM_RUN_MIGRATIONS=true
# Check for updates daily; Administration > General can override this default.
# SKRUM_UPDATE_CHECK_ENABLED=true
# Release feed asked by the update check.
# SKRUM_UPDATE_FEED=https://api.github.com/repos/arnaud-ritti/skrum/releases/latest

# Single sign-on: a provider is enabled when all its values are set.
# Callback URLs: ${APP_URL}/auth/{google|github|entra|oidc}/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ENTRA_TENANT=common
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# OIDC_BASE_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=

# Integrations: a provider appears on each team's integrations page when all its
# values are set. What each app needs (scopes, callback URLs) is in .env.example.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
# JIRA_DC_BASE_URL=
# JIRA_DC_CLIENT_ID=
# JIRA_DC_CLIENT_SECRET=
# JIRA_DC_PERSONAL_TOKENS=true
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_WEBHOOK_SECRET=
# MSTEAMS_ENABLED=false
# MSTEAMS_ALLOWED_HOSTS=
# MATTERMOST_URL=
# OUTGOING_WEBHOOKS_ENABLED=false
# OUTGOING_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
# OUTGOING_WEBHOOKS_ALLOW_HTTP=false
# How trackers report changes: auto, on or off; otherwise polled every N minutes.
# INTEGRATIONS_INBOUND_WEBHOOKS=auto
# INTEGRATIONS_POLL_MINUTES=5

# Other variables: README.md, "Configuration". Single sign-on, SMTP and the
# integrations can be set in Administration instead of here.

# Public demo only: use a dedicated DB_CONNECTION=sqlite database named demo.sqlite.
# All demo data is erased daily; never enable on a real instance.
SKRUM_DEMO=false
SKRUM_DEMO_RESET_TIME=03:00
